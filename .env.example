# Shared by the webhook and worker processes. Use an absolute path so both
# processes open the same database regardless of their working directory.
PATCHPROOF_SQLITE_PATH=/absolute/path/to/work/github-app.sqlite

# Webhook process. The secret must be at least 16 characters.
PORT=3000
PATCHPROOF_WEBHOOK_SECRET=
PATCHPROOF_GITHUB_APP_ID=
# The PEM body itself, with newlines encoded as \n escapes.
PATCHPROOF_GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Worker process. Absolute paths keep evidence next to a known location.
PATCHPROOF_EVIDENCE_ROOT=/absolute/path/to/work/github-evidence

# Required by the worker: comma-separated digest-pinned image references.
PATCHPROOF_APPROVED_DOCKER_IMAGES=
# Optional operator ceilings for worker execution (see docs/deployment.md).
# PATCHPROOF_MAX_TIMEOUT_MS=
# PATCHPROOF_MAX_OUTPUT_BYTES=
# PATCHPROOF_MAX_MEMORY_MB=
# PATCHPROOF_MAX_CPU_COUNT=
# PATCHPROOF_MAX_PIDS=
# PATCHPROOF_PROVISIONING_TIMEOUT_MS=
# Optional lease-owner label; defaults to worker-<process id>.
# PATCHPROOF_WORKER_ID=
